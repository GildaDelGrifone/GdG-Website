---
import site from '../data/site.json';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

// Aperture straordinarie future (rispetto al giorno della build, ora di Torino),
// raggruppate per weekend: date consecutive finiscono nello stesso gruppo.
const DAY = 86_400_000;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Rome' }).format(new Date());
const fmt = (opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('it-IT', { ...opts, timeZone: 'UTC' });
const weekday = fmt({ weekday: 'short' });
const dayMonth = fmt({ day: 'numeric', month: 'short' });
const dayOnly = fmt({ day: 'numeric' });
const month = fmt({ month: 'short' });

const groups: (typeof site.specialHours)[] = [];
site.specialHours
  .filter((s) => s.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date))
  .forEach((s, i, all) => {
    if (i === 0 || Date.parse(s.date) - Date.parse(all[i - 1].date) > DAY) groups.push([]);
    groups[groups.length - 1].push(s);
  });

// Un weekend per riga: "14–15 nov", "31 ott – 1 nov" o "sab 14 nov" se è un giorno solo.
const weekends = groups.map((days) => {
  const first = new Date(days[0].date);
  const last = new Date(days[days.length - 1].date);
  const label =
    days.length === 1
      ? `${weekday.format(first)} ${dayMonth.format(first)}`
      : month.format(first) === month.format(last)
        ? `${dayOnly.format(first)}–${dayMonth.format(last)}`
        : `${dayMonth.format(first)} – ${dayMonth.format(last)}`;
  const hours = days.map((s) => `${weekday.format(new Date(s.date))} ${s.open}–${s.close}`).join(' · ');
  return { start: days[0].date, end: days[days.length - 1].date, label, hours };
});

// Gli orari più frequenti si scrivono una volta sola sotto il titolo;
// un weekend con orari diversi li mostra nella sua riga.
const count = new Map<string, number>();
weekends.forEach((w) => count.set(w.hours, (count.get(w.hours) ?? 0) + 1));
const shared = [...count].sort((a, b) => b[1] - a[1])[0]?.[0];

// Nella versione completa si vedono i prossimi VISIBLE weekend, gli altri sotto "Mostra altre date".
const VISIBLE = 3;
const first = compact ? weekends : weekends.slice(0, VISIBLE);
const rest = compact ? [] : weekends.slice(VISIBLE);
const attrs = (w: (typeof weekends)[number]) => ({
  'data-start': w.start,
  'data-end': w.end,
  'data-own': w.hours !== shared ? '' : undefined,
});
---

<div
  class:list={['hours', { compact }]}
  data-hours={JSON.stringify(site.hours)}
  data-special={JSON.stringify(site.specialHours)}
>
  <p class="status" aria-live="polite"></p>
  <ul>
    {site.hours.map((h) => (
      <li data-day={h.day} class:list={{ closed: h.closed }}>
        <span>{h.label}</span>
        <span>{h.closed ? 'Chiuso' : `${h.open} – ${h.close}`}</span>
      </li>
    ))}
  </ul>
  {weekends.length > 0 && (
    <div class="special" data-visible={VISIBLE}>
      <p class="special-title">{compact ? 'Prossima apertura straordinaria' : 'Aperture straordinarie'}</p>
      <p class="special-hours muted">{shared}</p>
      <ul>
        {first.map((w, i) => (
          <li {...attrs(w)} hidden={compact && i > 0}>
            <span>{w.label}</span>
            {w.hours !== shared && <span>{w.hours}</span>}
          </li>
        ))}
      </ul>
      {rest.length > 0 && (
        <details class="more">
          <summary>Mostra altre date</summary>
          <ul>
            {rest.map((w) => (
              <li {...attrs(w)}>
                <span>{w.label}</span>
                {w.hours !== shared && <span>{w.hours}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}
  <p class="muted note">{site.hoursNote}</p>
</div>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; border-bottom: 1px solid var(--border); }
  li[hidden] { display: none; }
  li.closed { color: var(--muted); }
  li.today { color: var(--gold); font-weight: 700; }
  .status { font-weight: 700; margin: 0 0 8px; }
  .status:empty { display: none; }
  .status.open { color: var(--ok); }
  .status.shut { color: var(--muted); }
  .special-title { font-weight: 700; margin: 16px 0 4px; }
  .special-hours { font-size: 0.85rem; margin: 0 0 4px; }
  .note { font-size: 0.85rem; margin-bottom: 0; }
  .more summary { margin-top: 8px; font-size: 0.85rem; color: var(--gold); cursor: pointer; }
  .compact li { padding: 3px 0; font-size: 0.9rem; }
  .compact .special-title { margin-top: 12px; font-size: 0.9rem; }
</style>

<script>
  // Evidenzia il giorno corrente, nasconde le aperture straordinarie passate
  // e mostra se siamo aperti, usando l'ora di Torino.
  type Slot = { open?: string; close?: string; closed?: boolean };
  type Hour = Slot & { day: number };
  type Special = Slot & { date: string };

  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Rome',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(new Date());
  const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
  const dayIndex = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
  const minutes = (Number(get('hour')) % 24) * 60 + Number(get('minute'));
  const today = `${get('year')}-${get('month')}-${get('day')}`;
  const yesterday = new Date(Date.parse(today) - 86_400_000).toISOString().slice(0, 10);
  const toMin = (s: string) => {
    const [h, m] = s.split(':').map(Number);
    return h * 60 + m;
  };

  // Una chiusura prima dell'apertura (es. 20:00 – 00:30) finisce la notte dopo.
  const overnight = (s?: Slot) => !!s && !s.closed && !!s.open && !!s.close && toMin(s.close) < toMin(s.open);
  const isOpen = (s: Slot) =>
    !s.closed && !!s.open && !!s.close && minutes >= toMin(s.open) && (overnight(s) || minutes < toMin(s.close));

  document.querySelectorAll<HTMLElement>('.hours').forEach((el) => {
    const hours: Hour[] = JSON.parse(el.dataset.hours ?? '[]');
    const specials: Special[] = JSON.parse(el.dataset.special ?? '[]');
    const todaySpecial = specials.find((s) => s.date === today);
    el.querySelector(`li[data-day="${dayIndex}"]`)?.classList.add('today');
    // La settimana mostrata va da oggi ai prossimi 6 giorni: se uno di quei giorni
    // ha un'apertura straordinaria, la sua riga mostra quegli orari invece di "Chiuso".
    el.querySelectorAll<HTMLElement>('li[data-day]').forEach((row) => {
      const offset = (Number(row.dataset.day) - dayIndex + 7) % 7;
      const date = new Date(Date.parse(today) + offset * 86_400_000).toISOString().slice(0, 10);
      const s = specials.find((x) => x.date === date);
      if (!s) return;
      row.classList.remove('closed');
      row.lastElementChild!.textContent = `${s.open} – ${s.close}`;
      row.title = 'Apertura straordinaria';
    });

    // Aperture straordinarie: via quelle passate, nel footer solo il prossimo weekend.
    const special = el.querySelector<HTMLElement>('.special');
    if (special) {
      const rows = [...special.querySelectorAll<HTMLElement>('li[data-end]')];
      rows.filter((li) => li.dataset.end! < today).forEach((li) => li.remove());
      const left = rows.filter((li) => li.isConnected);
      if (!left.length) special.remove();
      else {
        // Tolte le date passate, i primi weekend restano in vista e gli altri sotto "Mostra altre date".
        const more = special.querySelector<HTMLElement>('details.more');
        if (more) {
          const visible = Number(special.dataset.visible);
          const main = special.querySelector<HTMLElement>(':scope > ul')!;
          const hidden = more.querySelector<HTMLElement>('ul')!;
          left.forEach((li, i) => (i < visible ? main : hidden).append(li));
          if (!hidden.children.length) more.remove();
        }
        if (el.classList.contains('compact')) {
          left.forEach((li, i) => (li.hidden = i > 0));
          // Se il prossimo weekend ha orari suoi, sono già nella riga.
          const shared = special.querySelector<HTMLElement>('.special-hours');
          if (shared) shared.hidden = left[0].dataset.own !== undefined;
        }
        left.find((li) => li.dataset.start! <= today && today <= li.dataset.end!)?.classList.add('today');
      }
    }

    const todaySlot: Slot | undefined = todaySpecial ?? hours.find((h) => h.day === dayIndex);
    const prevSlot: Slot | undefined =
      specials.find((s) => s.date === yesterday) ?? hours.find((h) => h.day === (dayIndex + 6) % 7);
    const status = el.querySelector<HTMLElement>('.status');
    if (!status) return;
    if ((overnight(prevSlot) && minutes < toMin(prevSlot!.close!)) || (todaySlot && isOpen(todaySlot))) {
      status.textContent = 'Siamo aperti ora!';
      status.classList.add('open');
    } else if (todaySlot && !todaySlot.closed && todaySlot.open && minutes < toMin(todaySlot.open)) {
      status.textContent = todaySpecial
        ? `Oggi apertura straordinaria alle ${todaySlot.open}`
        : `Apriamo oggi alle ${todaySlot.open}`;
      status.classList.add('shut');
    } else {
      status.textContent = 'Al momento siamo chiusi';
      status.classList.add('shut');
    }
  });
</script>
