---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articlePath } from '../../lib/urls';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="News" description="News dalla Gilda del Grifone di Torino: eventi, fiere, aperture straordinarie e novità della ludoteca e del gioco di ruolo.">
  <div class="container section">
    <h1>News</h1>
    {news.length ? (
      <div class="grid">
        {news.map((n) => <ArticleCard href={articlePath('news', n)} {...n.data} />)}
      </div>
    ) : <p class="muted">Nessuna news pubblicata.</p>}
  </div>
</BaseLayout>
