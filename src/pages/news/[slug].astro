---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleSchema } from '../../lib/schema';
import { imageSize } from '../../lib/images';
import { articleStaticPaths } from '../../lib/urls';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return articleStaticPaths(news);
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, excerpt, cover } = entry.data;
const coverSize = await imageSize(cover);
const dateLabel = date.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={title}
  description={excerpt}
  image={cover}
  type="article"
  published={date}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'News', path: '/news' }, { name: title, path: Astro.url.pathname }]}
  schema={[articleSchema(Astro.site!.origin, { title, date, image: cover, url: Astro.url.href })]}
>
  <article class="container section prose">
    <p class="muted"><a href="/news">← Tutte le news</a></p>
    <time datetime={date.toISOString()} class="muted">{dateLabel}</time>
    <h1>{title}</h1>
    {cover && <img src={cover} alt={title} {...coverSize} decoding="async" fetchpriority="high" />}
    <Content />
  </article>
</BaseLayout>
