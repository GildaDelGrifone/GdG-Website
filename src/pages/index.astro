---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import OpeningHours from '../components/OpeningHours.astro';
import TelegramButton from '../components/TelegramButton.astro';
import site from '../data/site.json';
import { articlePath } from '../lib/urls';

const byDate = <T extends { data: { date: Date } }>(a: T, b: T) => b.data.date.valueOf() - a.data.date.valueOf();
const serate = (await getCollection('serate')).sort(byDate).slice(0, 3);
const news = (await getCollection('news')).sort(byDate).slice(0, 3);
---

<BaseLayout
  seoTitle="Gilda del Grifone. Associazione Giochi di Ruolo e da Tavolo."
  description="Entra nella Gilda del Grifone a Torino: la tua community per il gioco di ruolo e da tavolo. Unisciti ai nostri tavoli, scopri la ludoteca e gioca con noi."
>
  <section class="hero">
    <div class="container">
      <img src="/logo-hero.webp" alt="Logo della Gilda del Grifone" width="800" height="573" fetchpriority="high" />
      <h1>Gilda del Grifone Torino</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="lead">
        La Gilda del Grifone è un'associazione di Torino dedicata ai giochi da tavolo e di ruolo.
        Oltre 400 giochi in ludoteca, tavoli aperti a tutti e campagne di gioco di ruolo: vieni a provare, ti spieghiamo noi le regole.
      </p>
      <TelegramButton />
    </div>
  </section>

  <section class="section container info">
    <div class="card">
      <h2>Chi siamo</h2>
      <p>
        Siamo un luogo di ritrovo per chi ama giocare. Non c'è consumazione minima né quota serale: serve solo la tessera associativa,
        valida un anno dall'iscrizione. I soci possono anche prendere in prestito giochi e manuali.
      </p>
      <p>
        <a href="/chi-siamo">La nostra storia</a> · <a href="/giochi-da-tavolo-torino">Ludoteca con oltre 400 giochi da tavolo</a> · <a href="/gioco-di-ruolo-torino">Gioco di ruolo a Torino: i manuali</a>
      </p>
    </div>
    <div class="card">
      <h2>Quando e dove</h2>
      <OpeningHours />
      <p><a href={site.mapUrl} rel="noopener">{site.address}</a></p>
    </div>
  </section>

  <section class="section container">
    <h2>Ultime serate</h2>
    {serate.length ? (
      <div class="grid">
        {serate.map((s) => <ArticleCard href={articlePath('serate', s)} {...s.data} />)}
      </div>
    ) : <p class="muted">Nessuna serata pubblicata.</p>}
    <p><a href="/serate">Tutte le serate →</a></p>
  </section>

  <section class="section container">
    <h2>News</h2>
    {news.length ? (
      <div class="grid">
        {news.map((n) => <ArticleCard href={articlePath('news', n)} {...n.data} />)}
      </div>
    ) : <p class="muted">Nessuna news pubblicata.</p>}
    <p><a href="/news">Tutte le news →</a></p>
  </section>
</BaseLayout>

<style>
  .hero { text-align: center; padding: 72px 0 56px; background: radial-gradient(ellipse at top, #2a3a55 0%, var(--bg) 70%); }
  .hero img { width: min(420px, 85%); height: auto; margin: 0 auto 8px; }
  .tagline { font-family: var(--font-display); font-size: 1.3rem; color: var(--gold); margin: -0.2em 0 1em; }
  .lead { max-width: 640px; margin: 0 auto 24px; color: var(--muted); font-size: 1.1rem; }
  .info { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
</style>
